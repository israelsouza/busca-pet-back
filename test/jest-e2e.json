{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@storage/(.*)$": "<rootDir>/../src/storage/$1",
    "^@users/(.*)$": "<rootDir>/../src/users/$1",
    "^@authorization/(.*)$": "<rootDir>/../src/authorization/$1",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
